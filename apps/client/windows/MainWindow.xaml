<Window x:Class="Codmes.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codmes" Width="900" Height="680" MinWidth="560" MinHeight="420">
  <Grid>
  <DockPanel x:Name="WorkspacePanel" Margin="18">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Codmes · windows + desktop" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition /></Grid.ColumnDefinitions>
        <TextBox x:Name="Server" Text="http://127.0.0.1:8787" Padding="8" />
        <TextBox x:Name="Token" Padding="8" Visibility="Collapsed" />
      </Grid>
      <Button Content="Connect" HorizontalAlignment="Left" Padding="18,7" Click="Connect_Click" Margin="0,0,0,12" />
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SurfaceContent" /></ScrollViewer>
  </DockPanel>
  <Border x:Name="LockCurtain" Background="White" Visibility="Collapsed">
    <StackPanel Width="300" VerticalAlignment="Center" HorizontalAlignment="Center">
      <TextBlock Text="Codmes app lock" FontSize="24" Margin="0,0,0,18" />
      <PasswordBox x:Name="UnlockPin" MaxLength="4" Padding="8" />
      <Button Content="Unlock" Click="Unlock_Click" Padding="12" Margin="0,12,0,0" />
      <TextBlock x:Name="LockError" TextWrapping="Wrap" Margin="0,12,0,0" />
    </StackPanel>
  </Border>
  </Grid>
</Window>
