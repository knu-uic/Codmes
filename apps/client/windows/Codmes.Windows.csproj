<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CodmesGoogleDesktopClientId Condition="'$(CodmesGoogleDesktopClientId)' == ''">$(CODMES_GOOGLE_DESKTOP_CLIENT_ID)</CodmesGoogleDesktopClientId>
    <CodmesGoogleDesktopClientId Condition="'$(CodmesGoogleDesktopClientId)' == ''">272235300599-2ckrabgut5u76c4ar9pebskj3r58o8vv.apps.googleusercontent.com</CodmesGoogleDesktopClientId>
    <CodmesGoogleDesktopClientSecret Condition="'$(CodmesGoogleDesktopClientSecret)' == ''">$(CODMES_GOOGLE_DESKTOP_CLIENT_SECRET)</CodmesGoogleDesktopClientSecret>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CodmesGoogleDesktopClientId</_Parameter1>
      <_Parameter2>$(CodmesGoogleDesktopClientId)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup Condition="'$(CodmesGoogleDesktopClientSecret)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CodmesGoogleDesktopClientSecret</_Parameter1>
      <_Parameter2>$(CodmesGoogleDesktopClientSecret)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
</Project>
